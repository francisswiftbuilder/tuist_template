import SwiftUI
import WidgetKit

struct {{ name }}Entry: TimelineEntry {
	let date: Date
}

struct {{ name }}Provider: TimelineProvider {
	func placeholder(in context: Context) -> {{ name }}Entry {
		{{ name }}Entry(date: Date())
	}

	func getSnapshot(in context: Context, completion: @escaping ({{ name }}Entry) -> Void) {
		completion({{ name }}Entry(date: Date()))
	}

	func getTimeline(
		in context: Context,
		completion: @escaping (Timeline<{{ name }}Entry>) -> Void
	) {
		completion(Timeline(entries: [{{ name }}Entry(date: Date())], policy: .atEnd))
	}
}

struct {{ name }}EntryView: View {
	let entry: {{ name }}Entry

	var body: some View {
		Text(entry.date, style: .time)
			.padding()
	}
}

struct {{ name }}: Widget {
	var body: some WidgetConfiguration {
		StaticConfiguration(kind: "{{ name }}", provider: {{ name }}Provider()) { entry in
			{{ name }}EntryView(entry: entry)
		}
		.supportedFamilies([.systemSmall, .systemMedium])
	}
}

@main
struct {{ name }}Bundle: WidgetBundle {
	var body: some Widget {
		{{ name }}()
	}
}
